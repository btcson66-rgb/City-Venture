    {
     "do": "timeline",
     "text": "Got an import through the Clearing Crisis.",
     "kind": "milestone"
    },
    {
     "do": "start",
     "objective": "goal_growth"
    }
   ]
  }
 ],
 "side": [
  {
   "id": "goal_rent",
   "main": false,
   "text": "Make $1,250 gross profit — next month's rent",
   "complete_when": [
    "stat:gross_profit_total>=1250"
   ],
   "on_complete": [
    {
     "do": "toast",
     "text": "Gross profit covers a month of rent.",
     "kind": "good",
     "icon": "home"
    },
    {
     "do": "timeline",
     "text": "Business gross profit passed one month of rent."
    }
   ]
  },
  {
   "id": "goal_month",
   "main": true,
   "goal": "Sandbox",
   "text": "Run {company} through month-end (June 30)",
   "complete_when": [
    "stat:month_closes>=1"
   ],
   "on_complete": [
    {
     "do": "chapter",
     "id": "ch4_growing_pains"
    }
   ]
  },
  {
   "id": "goal_growth",
   "main": true,
   "goal": "Sandbox",
   "text": "Grow {company}: $40,000 revenue in a month (Chapters 10–12 are coming)",
   "complete_when": [
    "stat:best_month_revenue>=40000"
   ]
  }
 ]
}
