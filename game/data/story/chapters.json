{
 "chapters": [
  {
   "id": "ch1_arrival",
   "title": "CHAPTER 1 — ARRIVAL",
   "subtitle": "$30,000. A laptop. A phone. A city.",
   "next": "ch2_first_customer",
   "objectives": [
    {
     "id": "ch1_phone",
     "main": true,
     "goal": "Arrival",
     "text": "Check your phone (Tab)",
     "complete_when": [
      "flag:maya_intro_done"
     ],
     "target": {
      "phone": true
     }
    },
    {
     "id": "ch1_outside",
     "main": true,
     "goal": "Arrival",
     "text": "Head outside and look around Riverside",
     "complete_when": [
      "visited:riverside"
     ],
     "target": {
      "district": "riverside"
     }
    },
    {
     "id": "ch1_coffee",
     "main": true,
     "goal": "Arrival",
     "text": "Grab a coffee at Bloom Coffee",
     "complete_when": [
      "flag:bought_coffee_bloom_coffee"
     ],
     "target": {
      "building": "bloom_coffee",
      "action": "buy_item"
     }
    },
    {
     "id": "ch1_cowork",
     "main": true,
     "goal": "Arrival",
     "text": "Visit Nexus Co-work in Startup Hub (walk east)",
     "complete_when": [
      "visited:nexus_cowork"
     ],
     "target": {
      "building": "nexus_cowork"
     }
    },
    {
     "id": "ch1_board",
     "main": true,
     "goal": "Earn Your First Dollar",
     "text": "Check the Business Board and pick a first business",
     "complete_when": [
      "flag:business_chosen"
     ],
     "target": {
      "building": "nexus_cowork",
      "action": "business_board"
     }
    }
   ],
   "on_complete": [
    {
     "do": "message",
     "from": "maya",
     "text": "Ecommerce? Like... selling stuff online?",
     "delay_min": 20
    },
    {
     "do": "message",
     "from": "maya",
     "text": "Buy low. Sell less low. Got it, haha.",
     "delay_min": 22
    }
   ]
  },
  {
   "id": "ch2_first_customer",
   "title": "CHAPTER 2 — FIRST CUSTOMER",
   "subtitle": "Earn your first dollar.",
   "next": "ch3_open_for_business",
   "objectives": [
    {
     "id": "ch2_supplier",
     "main": true,
     "goal": "Earn Your First Dollar",
     "text": "Buy your first stock (Company OS → Operations). Laptop at home or a co-work desk.",
     "complete_when": [
      "stat:purchase_orders>=1"
     ],
     "target": {
      "action": "open_company_os"
     }
    },
    {
     "id": "ch2_stock",
     "main": true,
     "goal": "Earn Your First Dollar",
     "text": "Wait for your stock to arrive: work a part-time shift meanwhile, and sleep at night",
     "complete_when": [
      "stat:stock_received>=1"
     ]
    },
    {
     "id": "ch2_listing",
     "main": true,
     "goal": "Earn Your First Dollar",
     "text": "Photograph your product and list it on ShopLane (Company OS → Sales)",
     "complete_when": [
      "stat:listings_active>=1"
     ],
     "target": {
      "action": "open_company_os"
     }
    },
    {
     "id": "ch2_order",
     "main": true,
     "goal": "Earn Your First Dollar",
     "text": "Wait for your first order",
     "complete_when": [
      "stat:orders_placed>=1"
     ]
    },
    {
     "id": "ch2_ship",
     "main": true,
     "goal": "Earn Your First Dollar",
     "text": "Pack the order at your packing table, then ship it",
     "complete_when": [
      "stat:orders_shipped>=1"
     ],
     "target": {
      "action": "pack_orders"
     }
    },
    {
     "id": "ch2_first_dollar",
     "main": true,
     "goal": "Earn Your First Dollar",
     "text": "Get the parcel delivered to your customer",
     "complete_when": [
      "stat:orders_delivered>=1"
     ],
     "on_complete": [
      {
       "do": "message",
       "from": "maya",
       "text": "Wait. Someone actually bought one??"
      },
      {
       "do": "toast",
       "text": "First revenue! ShopLane pays out on Mondays.",
       "kind": "good",
       "icon": "cash"
      },
      {
       "do": "start",
       "objective": "goal_rent"
      },
      {
       "do": "force_return",
       "delay_min": 1080
      }
     ]
    },
    {
     "id": "ch2_issue",
     "main": true,
     "goal": "First Customer",
     "text": "Deal with an unhappy customer (check your phone)",
     "complete_when": [
      "flag:first_issue_resolved"
     ],
     "target": {
      "phone": true
     }
    }
   ]
  },
  {
   "id": "ch3_open_for_business",
   "title": "CHAPTER 3 — OPEN FOR BUSINESS",
   "subtitle": "Make it official. Or don't.",
   "next": "",
   "objectives": [
    {
     "id": "ch3_register",
     "main": true,
     "goal": "Open for Business",
     "text": "Register your company at City Hall (Civic Center, take the Metro)",
     "complete_when": [
      "company_registered"
     ],
     "on_start": [
      {
       "do": "message",
       "from": "maya",
       "text": "If this is real, make it real. City Hall does registrations. Civic Center.",
       "delay_min": 90
      },
      {
       "do": "message",
       "from": "priya",
       "text": "FYI personal seller accounts cap out at $2,500/month on ShopLane. Registered businesses don't.",
       "delay_min": 240
      }
     ],
     "target": {
      "building": "city_hall",
      "action": "register_company"
     }
    },
    {
     "id": "ch3_bank",
     "main": true,
     "goal": "Open for Business",
     "text": "Open a business account for {company} at Nexus Bank (Financial District)",
     "complete_when": [
      "flag:business_account_opened"
     ],
     "target": {
      "building": "nexus_bank",
      "action": "bank_counter"
     }
    },
    {
     "id": "ch3_workspace",
     "main": true,
     "goal": "Open for Business",
     "text": "Decide where {company} works: home, a co-work desk, or Suite 2B (Startup Hub)",
     "complete_when": [
      "flag:workspace_chosen"
     ]
    },
    {
     "id": "ch3_os",
     "main": true,
     "goal": "Open for Business",
     "text": "Sit down at your desk and open Company OS as {company}",
     "complete_when": [
      "flag:company_os_opened_as_company"
     ],
     "target": {
      "action": "open_company_os"
     }
    }
   ],
   "on_complete": [
    {
     "do": "start",
     "objective": "goal_month"
    },
    {
     "do": "message",
     "from": "maya",
     "text": "Look at you. A whole company. Drinks on {company}?"
    }
   ]
  },
  {
   "id": "ch4_growing_pains",
   "title": "CHAPTER 4 — GROWING PAINS",
   "subtitle": "Too many orders. Not enough hours.",
   "next": "ch5_big_contract",
   "objectives": [
    {
     "id": "ch4_employer",
     "main": true,
     "goal": "Growing Pains",
     "text": "Register {company} as an employer (City Hall permits kiosk, Civic Center)",
     "complete_when": [
      "flag:employer_registered"
     ],
     "target": {
      "building": "city_hall",
      "action": "permits_info"
     },
     "on_start": [
      {
       "do": "message",
       "from": "maya",
       "text": "You packed boxes until 1 AM again, didn't you. You need help. Like, a person."
      }
     ]
    },
    {
     "id": "ch4_post",
     "main": true,
     "goal": "Growing Pains",
     "text": "Post your first job ad (Company OS → People)",
     "complete_when": [
      "stat:jobs_posted>=1"
     ],
     "target": {
      "action": "open_company_os"
     }
    },
    {
     "id": "ch4_hire",
     "main": true,
     "goal": "Growing Pains",
     "text": "Hire your first employee (applicants reply within a day)",
     "complete_when": [
      "stat:hires>=1"
     ],
     "target": {
      "action": "open_company_os"
     }
    },
    {
     "id": "ch4_payroll",
     "main": true,
     "goal": "Growing Pains",
     "text": "Make your first payroll: keep cash in the company for Friday 17:00",
     "complete_when": [
      "stat:payrolls_run>=1"
     ]
    },
    {
     "id": "ch4_forecast",
     "main": true,
     "goal": "Growing Pains",
     "text": "Revenue isn't cash: check the cash forecast (Company OS → Finance)",
     "complete_when": [
      "flag:cash_forecast_viewed"
     ],
     "target": {
      "action": "open_company_os"
     },
     "on_start": [
      {
       "do": "flag_reset",
       "flag": "cash_forecast_viewed"
      }
     ]
    }
   ],
   "on_complete": [
    {
     "do": "message",
     "from": "maya",
     "text": "A payroll. You're somebody's boss now. That's terrifying. Proud of you."
    }
   ]
  },
  {
   "id": "ch5_big_contract",
   "title": "CHAPTER 5 — THE BIG CONTRACT",
   "subtitle": "Daniel buys by the pallet.",
   "next": "ch6_cash_is_oxygen",
   "objectives": [
    {
     "id": "ch5_meet",
     "main": true,
     "goal": "The Big Contract",
     "text": "Meet Daniel Wong at Nexus Co-work (Thursdays 17:00–20:00)",
     "complete_when": [
      "flag:big_contract_offered"
     ],
     "target": {
      "building": "nexus_cowork"
     },
     "on_start": [
      {
       "do": "message",
       "from": "daniel",
       "text": "Daniel Wong, Crestline. You're doing real volume now. Let's talk. Nexus Co-work, Thursday after 5."
      },
      {
       "do": "event",
       "id": "crestline_big_offer",
       "delay_min": 8640
      }
     ]
    },
    {
     "id": "ch5_decide",
     "main": true,
     "goal": "The Big Contract",
     "text": "Crestline's offer is in Company OS → Contracts: accept, counter or decline",
     "complete_when": [
      "flag:big_contract_decided"
     ],
     "target": {
      "action": "open_company_os"
     }
    },
    {
     "id": "ch5_stock",
     "main": true,
     "goal": "The Big Contract",
     "text": "Get 800 desk lamps in stock or on the way (cash, supplier terms, a Nexus Bank loan or an investor)",
     "complete_when": [
      "contract_ready:big_contract || flag:big_contract_declined"
     ],
     "target": {
      "action": "open_company_os"
     }
    },
    {
     "id": "ch5_deliver",
     "main": true,
     "goal": "The Big Contract",
     "text": "Deliver Crestline's lamps before the deadline (Company OS → Contracts)",
     "complete_when": [
      "flag:big_contract_delivered || flag:big_contract_declined"
     ],
     "target": {
      "action": "open_company_os"
     }
    }
   ],
   "on_complete": [
    {
     "do": "message",
     "from": "daniel",
     "text": "Received. Accounts payable will process your invoice. Net 60, as agreed.",
     "if": "flag:big_contract_delivered"
    },
    {
     "do": "message",
     "from": "maya",
     "text": "You passed on the big one? Honestly, respect. Growth that kills you isn't growth.",
     "if": "flag:big_contract_declined"
    }
   ]
  },
  {
   "id": "ch6_cash_is_oxygen",
   "title": "CHAPTER 6 — CASH IS OXYGEN",
   "subtitle": "Profit on paper. Payroll on Friday.",
   "next": "ch7_supply_shock",
   "objectives": [
    {
     "id": "ch6_forecast",
     "main": true,
     "goal": "Cash Is Oxygen",
     "text": "Check the cash forecast: does {company} make it to the next big payment?",
     "complete_when": [
      "flag:forecast_checked_ch6"
     ],
     "target": {
      "action": "open_company_os"
     },
     "on_start": [
      {
       "do": "message",
       "from": "marcus",
       "text": "Marcus Reed here. Big invoices on long terms are how profitable companies run out of cash. My door's open, weekdays 1 to 4."
      },
      {
       "do": "event",
       "id": "elena_offer",
       "delay_min": 1440
      }
     ]
    },
    {
     "id": "ch6_bridge",
     "main": true,
     "goal": "Cash Is Oxygen",
     "text": "Bridge the gap: a bank loan, an investor, cutting costs or early payment",
     "complete_when": [
      "flag:loan_taken || flag:investor_elena || flag:costs_cut || flag:early_payment_agreed || forecast_ok"
     ],
     "target": {
      "building": "nexus_bank"
     }
    },
    {
     "id": "ch6_collect",
     "main": true,
     "goal": "Cash Is Oxygen",
     "text": "Collect the money Crestline owes you",
     "complete_when": [
      "flag:big_contract_paid || flag:big_contract_declined"
     ]
    },
    {
     "id": "ch6_close",
     "main": true,
     "goal": "Cash Is Oxygen",
     "text": "Close a month with cash in the bank",
     "complete_when": [
      "flag:ch6_month_in_black"
     ]
    }
   ],
   "on_complete": [
    {
     "do": "message",
     "from": "maya",
     "text": "You survived the cash crunch. Most people don't even know they're in one."
    },
    {
     "do": "timeline",
     "text": "Came through the cash crunch.",
     "kind": "milestone"
    }
   ]
  },
  {
   "id": "ch7_supply_shock",
   "title": "CHAPTER 7 — SUPPLY SHOCK",
   "subtitle": "The boxes are stuck at sea.",
   "next": "ch8_green_shift",
   "objectives": [
    {
     "id": "ch7_news",
     "main": true,
     "goal": "Supply Shock",
     "text": "Something's wrong with shipping: read the news board at Bloom Coffee",
     "complete_when": [
      "flag:news_read"
     ],
     "target": {
      "building": "bloom_coffee",
      "action": "read_news"
     },
     "on_start": [
      {
       "do": "flag_reset",
       "flag": "news_read"
      },
      {
       "do": "world_year",
       "year": 3
      },
      {
       "do": "message",
       "from": "ken",
       "text": "Heads up. Container rates just doubled and the port's backed up. Lead times are going to get ugly."
      }
     ]
    },
    {
     "id": "ch7_ken",
     "main": true,
     "goal": "Supply Shock",
     "text": "Talk to Ken about supply (Nexus Co-work, Tue and Thu 10–15), or wait for his call",
     "complete_when": [
      "flag:ch7_supply_plan"
     ],
     "target": {
      "building": "nexus_cowork"
     },
     "on_start": [
      {
       "do": "event",
       "id": "supply_shock_plan",
       "delay_min": 2880
      }
     ]
    },
    {
     "id": "ch7_stock",
     "main": true,
     "goal": "Supply Shock",
     "text": "Keep {company} stocked through the shock: 100 units in hand or on the way",
     "complete_when": [
      "stock_units>=100"
     ],
     "target": {
      "action": "open_company_os"
     }
    },
    {
     "id": "ch7_price",
     "main": true,
     "goal": "Supply Shock",
     "text": "Costs went up: raise a price to protect your margin (Company OS → Sales)",
     "complete_when": [
      "flag:repriced"
     ],
     "target": {
      "action": "open_company_os"
     },
     "on_start": [
      {
       "do": "flag_reset",
       "flag": "repriced"
      }
     ]
    },
    {
     "id": "ch7_close",
     "main": true,
     "goal": "Supply Shock",
     "text": "Close a month with a profit despite the shock",
     "complete_when": [
      "flag:ch7_month_profit"
     ]
    }
   ],
   "on_complete": [
    {
     "do": "message",
     "from": "maya",
     "text": "You kept the shelves full while half the city ran out. That's a real business."
    },
    {
     "do": "timeline",
     "text": "Came through the Supply Shock.",
     "kind": "milestone"
    }
   ]
  },
  {
   "id": "ch8_green_shift",
   "title": "CHAPTER 8 — THE GREEN SHIFT",
   "subtitle": "Aurelia goes electric.",
   "next": "ch9_clearing_crisis",
   "objectives": [
    {
     "id": "ch8_news",
     "main": true,
     "goal": "The Green Shift",
     "text": "The city passed the Clean Packaging Act: read the news board",
     "complete_when": [
      "flag:news_read"
     ],
     "target": {
      "building": "bloom_coffee",
      "action": "read_news"
     },
     "on_start": [
      {
       "do": "flag_reset",
       "flag": "news_read"
      },
      {
       "do": "world_year",
       "year": 4
      },
      {
       "do": "message",
       "from": "ana",
       "text": "Heads up for sellers: plastic-padded parcels now pay a $0.40 levy. The Green Business Grant opened too. Ask at the permits kiosk."
      }
     ]
    },
    {
     "id": "ch8_pack",
     "main": true,
     "goal": "The Green Shift",
     "text": "Switch to recycled packaging (Company OS → Operations)",
     "complete_when": [
      "flag:packaging_green"
     ],
     "target": {
      "action": "open_company_os"
     }
    },
    {
     "id": "ch8_product",
     "main": true,
     "goal": "The Green Shift",
     "text": "Add a green product: buy Verdant Supply's solar desk lamps and list them",
     "complete_when": [
      "listed:solar_lamp"
     ],
     "target": {
      "action": "open_company_os"
     },
     "on_start": [
      {
       "do": "message",
