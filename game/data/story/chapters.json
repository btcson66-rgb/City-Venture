     ]
    },
    {
     "id": "ch8_grant",
     "main": true,
     "goal": "The Green Shift",
     "text": "Apply for the Green Business Grant at the City Hall permits kiosk",
     "complete_when": [
      "flag:green_grant"
     ],
     "target": {
      "building": "city_hall",
      "action": "permits_info"
     }
    }
   ],
   "on_complete": [
    {
     "do": "message",
     "from": "maya",
     "text": "Green AND profitable? Who even are you."
    },
    {
     "do": "timeline",
     "text": "Went green with the city.",
     "kind": "milestone"
    }
   ]
  },
  {
   "id": "ch9_clearing_crisis",
   "title": "CHAPTER 9 — CLEARING CRISIS",
   "subtitle": "The payment still hasn't landed.",
   "next": "",
   "objectives": [
    {
     "id": "ch9_news",
     "main": true,
     "goal": "Clearing Crisis",
     "text": "Cross-border payments are jammed: read the news board",
     "complete_when": [
      "flag:news_read"
     ],
     "target": {
      "building": "bloom_coffee",
      "action": "read_news"
     },
     "on_start": [
      {
       "do": "flag_reset",
       "flag": "news_read"
      },
      {
       "do": "world_year",
       "year": 5
      },
      {
       "do": "message",
       "from": "marcus",
       "text": "Marcus Reed. Wires abroad are taking a week or more to clear. If you import, talk to Lina Zhao on our trade desk, weekdays 10 to 4."
      }
     ]
    },
    {
     "id": "ch9_import",
     "main": true,
     "goal": "Clearing Crisis",
     "text": "Order from Lumina Direct: factory prices, but you pay before it ships",
     "complete_when": [
      "stat:import_orders>=1"
     ],
     "target": {
      "action": "open_company_os"
     }
    },
    {
     "id": "ch9_lina",
     "main": true,
     "goal": "Clearing Crisis",
     "text": "The payment is stuck: talk to Lina Zhao at Nexus Bank (weekdays 10–16)",
     "complete_when": [
      "flag:met_lina"
     ],
     "target": {
      "building": "nexus_bank"
     }
    },
    {
     "id": "ch9_settle",
     "main": true,
     "goal": "Clearing Crisis",
     "text": "Get the payment through: wait for the wire, or speed it up (Company OS → Operations)",
     "complete_when": [
      "stat:import_cleared>=1"
     ],
     "target": {
      "action": "open_company_os"
     }
    },
    {
     "id": "ch9_arrive",
     "main": true,
     "goal": "Clearing Crisis",
     "text": "Receive the import from Lumina Direct",
     "complete_when": [
      "stat:import_received>=1"
     ]
    }
   ],
   "on_complete": [
    {
     "do": "message",
     "from": "lina",
     "text": "Payment landed, boxes arrived. Remember who held your money in between. That's this year's lesson."
