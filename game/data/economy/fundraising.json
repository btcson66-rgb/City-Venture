 "questions": {
  "q_traction": {
   "text": "What have customers actually paid you so far?",
   "options": [
    {
     "style": "numbers",
     "label": "Walk through the revenue and the orders delivered."
    },
    {
     "style": "vision",
     "label": "Explain the customer problem and where demand is heading."
    },
    {
     "style": "risk",
     "label": "Say plainly how small the sample is and what you are still testing."
    }
   ]
  },
  "q_margin": {
   "text": "How does the money flow: what is left after costs?",
   "options": [
    {
     "style": "numbers",
     "label": "Show profit and cash against the monthly costs."
    },
    {
     "style": "vision",
     "label": "Describe the scale effects that improve margin over time."
    },
    {
     "style": "risk",
     "label": "Name the costs that could squeeze the margin and your limit on each."
    }
   ]
  },
  "q_competition": {
   "text": "Who else can do this, and why would customers stay?",
   "options": [
    {
     "style": "numbers",
     "label": "Point to repeat orders and delivered volume as the proof."
    },
    {
     "style": "vision",
     "label": "Describe the position you are building that others will find hard to copy."
    },
    {
     "style": "risk",
     "label": "Admit where a rival could beat you and how you would respond."
    }
   ]
  },
  "q_runway": {
   "text": "If sales slow for six months, how long can you last?",
   "options": [
    {
     "style": "numbers",
     "label": "Give the months of cost your cash covers today."
    },
    {
     "style": "vision",
     "label": "Explain which line of business you would grow to ride it out."
    },
    {
     "style": "risk",
     "label": "Lay out the costs you would cut first and what you would protect."
    }
   ]
  },
  "q_team": {
   "text": "Who does the work, and who would you hire next?",
   "options": [
    {
     "style": "numbers",
     "label": "State the headcount and what each role earns the company."
    },
    {
     "style": "vision",
     "label": "Describe the team you are building and the skill you are missing."
    },
    {
     "style": "risk",
     "label": "Name the one person the company depends on and your backup plan."
    }
   ]
  },
  "q_use": {
   "text": "What exactly will you do with the cheque?",
   "options": [
    {
     "style": "numbers",
     "label": "Break the money down by line with the return you expect from each."
    },
    {
     "style": "vision",
     "label": "Describe the next step that the money makes possible."
    },
    {
     "style": "risk",
     "label": "Keep part in reserve and explain the milestones that release the rest."
    }
   ]
  }
 },
