	runner.check(not RealEstate.start()["ok"],"no-company gate")
	setup()
	runner.eq(RealEstate.listings().size(),9,"six apartments and three rowhouses")
	runner.eq(DataDB.district_def_in_city("residential")["status"],"active","map open")
