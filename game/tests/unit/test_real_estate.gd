extends RefCounted
var runner
func test_industry_navigation_stays_in_viewport() -> void:
	var modal := CompanyOS.new("home_laptop")
	UIRoot.open_modal(modal)
	await runner.get_tree().process_frame
	await runner.get_tree().process_frame
	runner.check(modal.panel.get_global_rect().position.y>=0 and modal.panel.get_global_rect().end.y<=360,"additional industry launcher cannot push OS outside screen")
	var launcher := modal.find_child("Tab_real_estate",true,false) as Button
	var nav: Node=launcher.get_parent()
	runner.check(nav.get_parent() is ScrollContainer,"all industry navigation has its own scroll")
	(nav.get_parent() as ScrollContainer).ensure_control_visible(launcher)
	await runner.get_tree().process_frame
	var rect := launcher.get_global_rect()
	runner.check(rect.position.y>=0 and rect.end.y<=360,"last launcher becomes actually clickable")
	modal.close()
	await runner.get_tree().process_frame
func setup(extra := 0.0) -> String:
	Company.register("Realty Test","real_estate","Harlow")
	Company.open_business_account(25000)
	if extra>0:Ledger.post(GameState.company_id(),"QA property equity",[{"acct":"cash","dr":extra},{"acct":"equity","cr":extra}])
	runner.check(Compliance.apply_permit("brokerage")["ok"],"paid exam application")
	runner.check(not RealEstate.licence(),"three-day processing")
	Clock.advance(3*Clock.DAY)
	runner.check(RealEstate.licence(),"licence granted")
	runner.check(Living.lease("realty_office")["ok"],"real brokerage lease")
	runner.check(RealEstate.start()["ok"],"brokerage opens")
	return GameState.company_id()
