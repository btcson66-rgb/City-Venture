	runner.eq(GameState.data["messages"].size(), before + 2, "one note when it lapsed, not one per hour")
	runner.check(GameState.data["messages"].back()["target"]["tab"] == "governance", "Go opens Governance")
	for day in 5:Clock.advance(Clock.DAY)
	runner.eq(GameState.data["messages"].size(), before + 2, "no repeat")
