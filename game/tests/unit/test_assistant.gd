func test_fleet_assistant_waits_for_return_and_preserves_real_service_cost() -> void:
	var fixture = load("res://tests/unit/test_automotive.gd").new()
	fixture.runner = runner
	var entity: String = fixture.setup(100000)
	fixture.fleet_ready(entity,1)
	var id: String = str(Automotive.S()["fleet"].keys()[0])
	var asset := Automotive.fleet_item(id)
	asset["maintenance_due"] = true
	asset["status"] = "broken"
	Automotive.S()["fleet"][id]["rental"] = "QA occupied vehicle"
	activate()
	var cash := Ledger.cash(entity)
	AssistantPolicy._maintain()
	runner.eq(Ledger.cash(entity),cash,"occupied car is never magically repaired")
	Automotive.S()["fleet"][id]["rental"] = ""
	var cost := Automotive.service_cost(id)
	AssistantPolicy._maintain()
	runner.eq(Ledger.cash(entity),cash-cost,"actual service labor and parts charged")
	runner.eq(Automotive.S()["fleet"][id]["out"],Clock.day_index()+1,"one-day service downtime retained")
	for day in 90:Clock.advance(Clock.DAY)
	runner.check(Ledger.cash(entity)>0,"funded existing fleet operates for 90 days")
	runner.check(Ledger.check_balanced(),"fleet books balance")

func test_new_games_default_on_loaded_old_saves_default_off_with_one_calm_note() -> void:
	runner.check(AssistantPolicy.TASKS.keys().all(func(id):return AssistantPolicy.S()["tasks"][id]), "a new game starts with the assistant on")
	var old: Dictionary = JSON.parse_string(JSON.stringify(GameState.data))
	old.erase("assistant")
	var cash := Ledger.cash("player")
	GameState.data = SaveSystem._migrate(old)
	runner.check(AssistantPolicy.TASKS.keys().all(func(id):return not AssistantPolicy.S()["tasks"][id]), "an old save without the key stays manual")
	var before: int = GameState.data["messages"].size()
	AssistantPolicy.after_load()
	AssistantPolicy.after_load()
	runner.eq(GameState.data["messages"].size(), before + 1, "exactly one explanation")
	var note: Dictionary = GameState.data["messages"].back()
	runner.check(str(note["text"]).contains("Settings") and not note.has("target"), "calm note says where to turn it on and has no demand")
	runner.eq(Ledger.cash("player"), cash, "veteran cash does not move")
	AssistantPolicy.on_hour(Clock.now(), 6)
	runner.eq(Ledger.cash("player"), cash, "nothing is delegated until the player opts in")
	var again: Dictionary = SaveSystem._migrate(JSON.parse_string(JSON.stringify(GameState.data)))
	runner.check(AssistantPolicy.TASKS.keys().all(func(id):return not again["assistant"]["tasks"][id]) and not again["assistant"].has("intro_pending"), "choice and one-time note survive another load")
