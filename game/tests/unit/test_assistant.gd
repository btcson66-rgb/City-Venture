func test_master_toggle_only_flips_listed_chores() -> void:
	AssistantPolicy.set_all(false)
	var listed: Array = AssistantPolicy.TASKS.keys().filter(func(id):return AssistantPolicy.available(str(id)))
	var hidden: Array = AssistantPolicy.TASKS.keys().filter(func(id):return not AssistantPolicy.available(str(id)))
	runner.check(not hidden.is_empty() and not listed.is_empty(), "day one lists some chores and hides others")
	AssistantPolicy.set_all(true, true)
	for id in listed:runner.check(AssistantPolicy.S()["tasks"][id], "listed chore flipped: " + str(id))
	for id in hidden:runner.check(not AssistantPolicy.S()["tasks"][id], "unlisted chore untouched: " + str(id))
	var box := VBoxContainer.new()
	AssistantPolicy.master(box)
	var all := box.find_child("AssistantAll", true, false) as CheckBox
	runner.check(all.button_pressed, "master shows on when every listed chore is on")
	box.free()
func test_manual_bills_have_due_date_one_modest_late_fee_and_pay_all() -> void:
	Company.register("Bill Co", "ecommerce", "22 Founders Lane")
	Company.open_business_account(8000)
	var company := GameState.company_id()
	AssistantPolicy.set_task("bills", false)
	AssistantPolicy.bill("player", "living", 40, "Week one", {"type": "living"})
	AssistantPolicy.bill(company, "rent_shop", 100, "Shop rent", {"type": "lease"})
	var bills: Array = AssistantPolicy.S()["bills"]
	runner.check(bills.all(func(b):return int(b["due"]) > Clock.now()), "every bill has a due date")
	var box := VBoxContainer.new()
	AssistantPolicy.bills_ui(box)
	runner.check(box.find_child("AssistantBill_0", true, false) != null and box.find_child("AssistantBill_1", true, false) != null, "player and company bills are both listed")
	runner.check(box.find_child("AssistantPayAll", true, false) != null, "pay all is offered")
	box.free()
	var cash := Ledger.cash("player")
	AssistantPolicy.overdue(Clock.now())
	runner.eq(Ledger.cash("player"), cash, "no fee before the due date")
	var late := Clock.now() + 8 * Clock.DAY
	AssistantPolicy.overdue(late)
	var fee := float(AssistantPolicy.cfg()["bill_late_fee"])
	runner.eq(Ledger.balance("player", "exp:late_fees"), fee, "player bill gets one flat modest fee")
	runner.eq(Ledger.balance(company, "exp:late_fees"), fee, "company bill gets one flat modest fee")
	runner.check(fee <= 25, "late fee stays modest")
	AssistantPolicy.overdue(late + 30 * Clock.DAY)
	runner.eq(Ledger.balance("player", "exp:late_fees"), fee, "no compounding")
	runner.eq(AssistantPolicy.pay_all(), 2, "pay all settles both")
	runner.check(AssistantPolicy.unpaid().is_empty(), "nothing left to pay")
	runner.check(Ledger.check_balanced(), "books balance")
func test_auto_pay_never_overdrafts_and_posts_one_note_per_entity() -> void:
	Company.register("Short Co", "ecommerce", "22 Founders Lane")
	Company.open_business_account(500)
	var company := GameState.company_id()
	var player_cash := Ledger.cash("player")
	Ledger.expense("player", "living", player_cash - 20.0, "QA drain", {"type": "test_fixture"})
	Ledger.expense(company, "other", Ledger.cash(company) - 10.0, "QA drain", {"type": "test_fixture"})
	AssistantPolicy.set_task("bills", true)
	var messages: int = GameState.data["messages"].size()
	var paid_a: bool = AssistantPolicy.bill("player", "living", 200, "Player bill", {"type": "living"})
	var paid_b: bool = AssistantPolicy.bill(company, "rent_shop", 300, "Company bill", {"type": "lease"})
	runner.check(not paid_a and not paid_b, "short cash leaves the bill unpaid")
	runner.check(Ledger.cash("player") >= 0 and Ledger.cash(company) >= 0, "no overdraft")
	runner.eq(GameState.data["messages"].size(), messages + 2, "one note for the player and one for the company")
	AssistantPolicy.bill("player", "living", 50, "Player bill 2", {"type": "living"})
	AssistantPolicy.bill(company, "rent_shop", 50, "Company bill 2", {"type": "lease"})
	GameState.set_flag("test_assistant_run")
	AssistantPolicy.on_hour(Clock.now(), 12)
	AssistantPolicy.on_hour(Clock.now(), 13)
	runner.eq(GameState.data["messages"].size(), messages + 2, "still only one note per entity while it waits")
	Ledger.post("player", "QA cash", [{"acct": "cash", "dr": 5000}, {"acct": "equity", "cr": 5000}], {"type": "test_fixture"})
	AssistantPolicy.on_hour(Clock.now(), 14)
	runner.check(AssistantPolicy.unpaid("player").is_empty(), "the assistant pays once cash arrives")
	runner.check(Ledger.check_balanced(), "books balance")
func test_daily_living_is_one_weekly_bill() -> void:
	AssistantPolicy.set_task("bills", false)
	var start := Clock.now()
	for day in 14:Clock.advance(Clock.DAY)
	var living: Array = AssistantPolicy.S().get("bills", []).filter(func(b):return b["source"].get("type", "") == "living")
	runner.check(living.size() >= 2 and living.size() <= 3, "two weeks make two or three bills, not fourteen (got %d)" % living.size())
	runner.check(living.all(func(b):return is_equal_approx(float(b["amount"]), Living.daily_living() * 7.0)), "each bill is seven days of living")
	runner.check(Clock.now() > start and Ledger.check_balanced(), "balanced")
