extends RefCounted
var bot
func _init(b) -> void:bot = b
func run() -> void:
	UIRoot._suppress_decisions = true
	Help.auto = false
	GameState.new_game({"name":"Alex Chen","seed":154})
	GameState.data["tutorial"] = {"off":true,"v":99,"seen":{}}
	Clock.clear_pauses()
	Clock.world_active = false
	SceneRouter._enter("interior", Living.home_building(), Living.home_bed(), "down")
	UIRoot.set_hud_visible(true)
	UIRoot.open_modal(AssistantModal.new())
	await bot.wait(.4)
	await bot.shot("maya_before_first_parcel")
	bot.expect(not AssistantPolicy.hired(), "fresh game has no helper")
	bot.expect(UIRoot.top_modal().find_child("AssistantHire", true, false).disabled, "first parcel required")
	bot.expect(bot.button_named("AssistantAll") == null, "no delegation switch before hire")
	await bot.click_named("AssistantDone")
	# Capitalized stock and a simulated real domestic customer order are a declared focused fixture.
	# Packing, courier booking, scheduled pickup, hiring and following automation use actual APIs/input.
	Ecommerce._add_stock(Living.home(), "water_bottle", 8, 5.0, 0.0)
	Ledger.post("player", "Tour paid opening stock", [{"acct":"inventory","dr":40.0},{"acct":"cash","cr":40.0}], {"segment":"ecommerce"})
	Ecommerce.create_listing("water_bottle", 18, "self", .9)
	var listing := Ecommerce.listing_for("water_bottle")
	Ecommerce._h_order_place({"listing":listing["id"]})
	UIRoot.open_modal(PackShipModal.new(Living.home()))
	await bot.wait(.3)
	await bot.shot("first_parcel_manual_packing")
	bot.expect(bot.button_named("Assistant_packing") == null, "no packing automation before hire")
	await bot.click_named("Pack")
	await bot.wait(.7)
	await bot.click_named("CourierEconomy")
	await bot.wait(.3)
	UIRoot.close_all()
	Clock.advance(121)
	bot.expect(GameState.stat("orders_shipped") >= 1 and not AssistantPolicy.hired(), "real courier pickup offers help but does not hire")
	var tour := Walkthrough.new(bot)
	await tour._hire_maya_after_manual_shipment()
	var before := GameState.stat("orders_shipped")
	Ecommerce._h_order_place({"listing":listing["id"]})
	Clock.advance(180)
	bot.expect(GameState.stat("orders_shipped") > before, "next actual customer parcel shipped by hired chosen helper")
	await bot.shot("maya_next_parcel_automated")
	UIRoot.open_modal(AssistantModal.new())
	await bot.wait(.3)
	await bot.click_named("AssistantMore")
	await bot.click_named("AssistantDismiss")
	await bot.shot("maya_dismissed_manual_recovery")
	bot.expect(not AssistantPolicy.hired() and not AssistantPolicy.permitted("packing"), "dismissal stops automation and retains manual path")
	await bot.click_named("AssistantHire")
	bot.expect(AssistantPolicy.hired() and AssistantPolicy.permitted("packing"), "paid rehire restores player preferences")
	UIRoot.close_all()
	Clock.advance(AssistantPolicy.S()["paid_until"] - Clock.now())
	var cash := Ledger.cash("player")
	Ledger.post("player", "Tour real cash reserved in deposit", [{"acct":"deposits","dr":cash},{"acct":"cash","cr":cash}], {"type":"qa_cash_reserve"})
	AssistantPolicy.renew_due(Clock.now())
	UIRoot.open_modal(AssistantModal.new())
	await bot.wait(.3)
	await bot.shot("maya_unpaid_pause_manual_available")
	bot.expect(AssistantPolicy.S()["paused"] and UIRoot.top_modal().find_child("AssistantResume", true, false).disabled, "short cash pauses without wage debt")
	Ledger.post("player", "Tour actual deposit withdrawal", [{"acct":"cash","dr":10.0},{"acct":"deposits","cr":10.0}], {"type":"qa_cash_reserve"})
	UIRoot.top_modal().rebuild()
	await bot.wait(.3)
	await bot.click_named("AssistantResume")
	await bot.wait(.2)
	await bot.shot("maya_resumed_with_actual_cash")
	bot.expect(not AssistantPolicy.S()["paused"], "actual cash resumes help")
	bot.expect(Ledger.check_balanced(), "hire upgrade dismissal retainer and real shipment ledger balanced")
	UIRoot.close_all()
	var fixture := "res://tests/fixtures/saves/pr182-pre-fun-ch3.json"
	var imported := SaveSystem.import_text(FileAccess.get_file_as_string(fixture))
	if not bot.expect(imported.get("ok", false), "genuine played predecessor imported"):return
	bot.expect(SaveSystem.load_and_enter(int(imported["slot"])), "genuine played enabled predecessor save loaded")
	await bot.wait(.4)
	UIRoot.close_all()
	UIRoot.open_modal(AssistantModal.new())
	await bot.wait(.3)
	await bot.shot("maya_genuine_oldsave_preserved")
	bot.expect(AssistantPolicy.hired() and int(AssistantPolicy.S()["level"]) == 2, "old enabled services adopted with one week grace")
	bot.expect(Ledger.check_balanced(), "genuine old books remain balanced")
	UIRoot.close_all()
